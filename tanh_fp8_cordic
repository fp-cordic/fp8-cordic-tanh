module tanh_fp8_asic(
    input clk,
    input EN,
    input [4:-3] z,
    input [7:0] x_init,   // ADD THIS
    output [7:0] tanh_out
);
wire [7:0] x,y;
wire done;
wire tanh_done;
// In tanh_fp8_asic, pass z directly if exp==0 (denormal ~ 0)
wire z_denormal = (z[3:0] == 4'b0000);  // correct - exp bits are [3:0] // exp bits of z
// route to output directly if denormal, skip cordic
cordic_bfloat_hypb_fp32 t1(
    .clk(clk),
    .EN(EN),
    .z(z),
    .x_init(x_init),   
    .x_out(x),
    .y_out(y),
    .done(done)
);
 reg q;
 wire lin_enable = done ? done & !q : lin_enable;
always@(posedge clk)begin
    if(EN) q<= 1'd0;
    else
    q <= done;
end
wire [7:0] cordic_out;  
cordic_bfloat_linearfp32 t2(.clk(clk),.EN(lin_enable),.x(x),.y(y),.done(tanh_done),.out(cordic_out));
assign tanh_out = z_denormal ? {z[4], z[3:0], z[-1:-3]} : cordic_out;
endmodule
