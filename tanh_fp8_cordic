module atanh_LOOKUP_linear_8(index, value);
    localparam EXP_SIZE = 4;
    localparam SIGN_SIZE = 1;
    localparam MANTISSA_SIZE = 3;

    input wire signed [7:0] index;
    output reg signed [SIGN_SIZE + EXP_SIZE-1:-MANTISSA_SIZE] value;

    always @(index)
    begin
        case (index)
            -4: value = 8'h38; // atanh(1 - 2^-6) ≈ 2.422 → 2.50
            -3: value = 8'h37; // atanh(1 - 2^-5) ≈ 2.072 → 2.00

            -2: value = 8'h37; // atanh(1 - 2^-4) ≈ 1.717 → 1.75
            -1: value = 8'h36; // atanh(1 - 2^-3) ≈ 1.354 → 1.375
             0: value = 8'h34; // atanh(1 - 2^-2) ≈ 0.973 → 1.00
             1: value = 8'h30; // atanh(2^-1)     ≈ 0.549 → 0.5625
             2: value = 8'h28; // atanh(2^-2)     ≈ 0.255 → 0.25
             3: value = 8'h20; // atanh(2^-3)     ≈ 0.126 → 0.125

             4: value = 8'h18; // atanh(2^-4)     ≈ 0.0626
             5: value = 8'h10; // atanh(2^-5)     ≈ 0.03126
